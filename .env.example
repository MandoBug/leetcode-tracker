# copy to .env and fill in. .env is gitignored, so real values never get committed

# LeetCode session: from the browser dev tools while logged in (Application > Cookies > leetcode.com)
LEETCODE_SESSION=
LEETCODE_CSRF=

# Postgres: either one URL...
DATABASE_URL=postgresql://user:password@localhost:5432/leetcode
# ...or the separate pieces (used when DATABASE_URL is empty)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

REDIS_URL=redis://localhost:6379

# on Railway, point services at the PRIVATE urls with reference variables:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
# and only use the *_PUBLIC_URL values when running scripts from a laptop
